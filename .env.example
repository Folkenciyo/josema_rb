# Dev (docker-compose.yml): only these are used, the rest have safe defaults.
JWT_SECRET=change-me-to-a-random-secret
TRAINER_EMAIL=trainer@example.com
TRAINER_PASSWORD=change-me

# Production (docker-compose.prod.yml): set these in the Dokploy panel.
# POSTGRES_PASSWORD has no default on purpose — the stack refuses to start without it.
POSTGRES_PASSWORD=
# POSTGRES_USER=josema
# POSTGRES_DB=josema_rb
